<Window x:Class="NightVisionTool.Windows.NightVisionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:NightVisionTool.Controls"
        Title="智能夜视滤镜 - FPS 工具箱"
        Width="680" Height="460"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#4EC9B0"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <Style x:Key="ValueInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="66"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0B7A5C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#109F79"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8B0000"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#555"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="GroupHeader">
            <Setter Property="Foreground" Value="#4EC9B0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- 顶部 -->
        <Border DockPanel.Dock="Top" Background="#252526" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🌙 智能夜视滤镜" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="  (暗部提亮 + 亮部保护)" FontSize="11" Foreground="#888"
                               VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBlock Text="显示器:" Style="{StaticResource Lbl}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbMonitors" Width="240" SelectionChanged="OnMonitorChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部按钮栏 -->
        <Border DockPanel.Dock="Bottom" Background="#252526" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Foreground="#888" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnToggle" Content="开启夜视" Click="OnToggleClicked" MinWidth="90"/>
                    <Button Content="重置为默认" Style="{StaticResource SecondaryBtn}" Click="OnResetClicked"/>
                    <Button Content="关闭程序" Style="{StaticResource DangerBtn}" Click="OnCloseClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中间 -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">

                <!-- 参数区 -->
                <TextBlock Style="{StaticResource GroupHeader}" Text="● 参数"/>
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="76"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="夜视强度"/>
                    <Slider x:Name="SldStrength" Grid.Row="0" Grid.Column="1"
                            Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="OnSliderChanged"/>
                    <TextBox x:Name="TxtStrength" Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueInput}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="亮部保护"/>
                    <Slider x:Name="SldProtect" Grid.Row="1" Grid.Column="1"
                            Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="OnSliderChanged"/>
                    <TextBox x:Name="TxtProtect" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueInput}"/>
                </Grid>

                <!-- 热键 -->
                <TextBlock Style="{StaticResource GroupHeader}" Text="● 全局热键"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="开/关夜视"/>
                    <TextBox Grid.Column="1" x:Name="TxtHotkey" Text="F9"
                             LostFocus="OnHotkeyChanged"
                             ToolTip="示例: F9  /  Ctrl+Alt+N  /  Ctrl+Shift+F2"/>
                </Grid>

                <!-- 方案 -->
                <TextBlock Style="{StaticResource GroupHeader}" Text="● 方案"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Lbl}" Text="方案名称"/>
                    <ComboBox Grid.Column="1" x:Name="CmbSchemes" IsEditable="True"/>
                    <Button Grid.Column="2" Content="加载" Click="OnLoadSchemeClicked" Style="{StaticResource SecondaryBtn}"/>
                    <Button Grid.Column="3" Content="保存" Click="OnSaveSchemeClicked"/>
                    <Button Grid.Column="4" Content="删除" Click="OnDeleteSchemeClicked" Style="{StaticResource DangerBtn}"/>
                </Grid>

                <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                           Text="提示:夜视强度越高暗部越亮;亮部保护越高,室内光源越不易过曝(代价是暗部提亮略减)。通过右侧曲线实时观察效果。"/>

            </StackPanel>

            <!-- 右侧曲线 -->
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource GroupHeader}" Text="● LUT 曲线"/>
                <Border BorderBrush="#444" BorderThickness="1" Height="240">
                    <ctrl:NightVisionCurveView x:Name="CurveView"/>
                </Border>
                <TextBlock Text="对角虚线 = 原始(无变换)" Foreground="#666" FontSize="11" Margin="0,4,0,10"/>

                <TextBlock Style="{StaticResource GroupHeader}" Text="● 夜视状态"/>
                <Border Background="#2D2D30" BorderBrush="#444" BorderThickness="1" Padding="10">
                    <TextBlock x:Name="TxtPreviewState" Text="未开启" Foreground="#AAA" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
