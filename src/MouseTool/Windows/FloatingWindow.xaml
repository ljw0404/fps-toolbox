<Window x:Class="MouseTool.Windows.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠鼠工具"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="280" Height="190"
        Topmost="True"
        MouseLeftButtonDown="OnWindowMouseDown">

    <Window.Resources>
        <!-- 小按钮基础样式 -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层阴影容器 -->
    <Border Margin="6" CornerRadius="10"
            x:Name="PanelBorder"
            BorderThickness="1" BorderBrush="#44FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="4"
                              Color="Black" Opacity="0.55"/>
        </Border.Effect>
        <Border.Background>
            <!-- 背景色由 code-behind 动态设置 -->
            <SolidColorBrush x:Name="PanelBackground" Color="#CC101827"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ── 标题栏 ── -->
            <Grid Grid.Row="0" Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🐭" FontSize="13" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="鼠鼠工具" FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#E0E0E0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnSettings"
                        Style="{StaticResource IconBtn}"
                        ToolTip="设置" Content="⚙"
                        Click="OnSettingsClicked"
                        Margin="0,0,2,0"/>
                <Button Grid.Column="2" x:Name="BtnHide"
                        Style="{StaticResource IconBtn}"
                        ToolTip="隐藏（热键可再次显示）" Content="－"
                        Click="OnHideClicked"/>
            </Grid>

            <!-- ── 内容区域 ── -->
            <StackPanel Grid.Row="1" Margin="12,4,12,4"
                        VerticalAlignment="Center">

                <!-- 示例状态行 -->
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📌 鼠标 DPI"
                               Foreground="#99AABB" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="TxtDpi"
                               Text="800" Foreground="#7EC8E3"
                               FontSize="12" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🎯 灵敏度换算"
                               Foreground="#99AABB" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="TxtSens"
                               Text="0.35" Foreground="#7EC8E3"
                               FontSize="12" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📐 360° 距离"
                               Foreground="#99AABB" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="TxtCm360"
                               Text="—" Foreground="#7EC8E3"
                               FontSize="12" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🕹️ eDPI"
                               Foreground="#99AABB" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="TxtEdpi"
                               Text="280" Foreground="#A8D8A8"
                               FontSize="12" FontWeight="Bold"/>
                </Grid>

            </StackPanel>

            <!-- ── 底部提示栏 ── -->
            <Border Grid.Row="2"
                    Background="#14FFFFFF"
                    CornerRadius="0,0,10,10">
                <TextBlock x:Name="TxtHint"
                           Text="拖动移动  |  F10 显示/隐藏"
                           FontSize="10.5" Foreground="#55AABB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Border>
</Window>
