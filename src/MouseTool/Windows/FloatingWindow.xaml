<Window x:Class="MouseTool.Windows.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="鼠鼠工具"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="300" MinHeight="280"
        Width="420" Height="420"
        Topmost="True"
        MouseLeftButtonDown="OnWindowMouseDown">

    <Window.Resources>
        <!-- 图标按钮 -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#88AABB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色 ComboBox -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E2D3D"/>
            <Setter Property="Foreground" Value="#E0E8F0"/>
            <Setter Property="BorderBrush" Value="#446688"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1E2D3D"/>
                        <Setter Property="Foreground" Value="#E0E8F0"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A4060"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1A3A5A"/>
                                            <Setter Property="Foreground" Value="#7EC8E3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <!-- 主体边框 -->
                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <!-- 当前选中项 -->
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>
                            <!-- 箭头 -->
                            <TextBlock Grid.Column="1" Text="▾"
                                       FontSize="10"
                                       Foreground="#7EC8E3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <!-- 透明点击区 -->
                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 下拉弹出 -->
                            <Popup Grid.ColumnSpan="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   MinWidth="{TemplateBinding ActualWidth}">
                                <Border Background="#1A2B3C"
                                        BorderBrush="#446688"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 护甲等级筛选按钮（覆盖系统白色样式） -->
        <Style x:Key="LevelBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab 按钮 -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#668899"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22AADDFF"/>
                                <Setter Property="Foreground" Value="#7EC8E3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层阴影 -->
    <Border Margin="6" CornerRadius="10"
            x:Name="PanelBorder"
            BorderThickness="1" BorderBrush="#33FFFFFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Color="Black" Opacity="0.6"/>
        </Border.Effect>
        <Border.Background>
            <SolidColorBrush x:Name="PanelBackground" Color="#FF101827"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- ── 标题栏 ── -->
            <Grid Grid.Row="0" Margin="10,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐭" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="三角洲信息板" FontSize="13" FontWeight="SemiBold"
                               Foreground="#D0E4F0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDate" Text="  —" FontSize="11"
                               Foreground="#44AABB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh" Style="{StaticResource IconBtn}"
                            ToolTip="刷新数据" Content="⟳" FontSize="15"
                            Click="OnRefreshClicked" Margin="0,0,2,0"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource IconBtn}"
                            ToolTip="设置" Content="⚙"
                            Click="OnSettingsClicked" Margin="0,0,2,0"/>
                    <Button x:Name="BtnHide" Style="{StaticResource IconBtn}"
                            ToolTip="隐藏" Content="－"
                            Click="OnHideClicked"/>
                </StackPanel>
            </Grid>

            <!-- ── Tab 栏（内容过多时允许横向滚动，隐藏滚动条） ── -->
            <Border Grid.Row="1" Background="#0AFFFFFF"
                    BorderBrush="#22FFFFFF" BorderThickness="0,1,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Margin="6,2,0,2"
                                VerticalAlignment="Center">
                        <RadioButton x:Name="TabPassword" GroupName="Tabs"
                                     Content="🗝️ 密码" Style="{StaticResource TabBtn}"
                                     IsChecked="True" FontSize="11"
                                     Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabCraft" GroupName="Tabs"
                                     Content="🔧 制作" Style="{StaticResource TabBtn}"
                                     FontSize="11" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabItems" GroupName="Tabs"
                                     Content="📦 活动" Style="{StaticResource TabBtn}"
                                     FontSize="11" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabAmmo" GroupName="Tabs"
                                     Content="🔫 子弹" Style="{StaticResource TabBtn}"
                                     FontSize="11" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabArmor" GroupName="Tabs"
                                     Content="🛡️ 装备" Style="{StaticResource TabBtn}"
                                     FontSize="11" Checked="OnTabChanged"/>
                        <RadioButton x:Name="TabGun" GroupName="Tabs"
                                     Content="🔩 改枪" Style="{StaticResource TabBtn}"
                                     FontSize="11" Checked="OnTabChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── 内容区 ── -->
            <Grid Grid.Row="2">

                <!-- 加载中 / 错误 遮罩 -->
                <Border x:Name="LoadingMask" Background="#CC101827"
                        CornerRadius="0" Visibility="Visible" Panel.ZIndex="10">
                    <TextBlock x:Name="TxtLoadingMsg" Text="⏳ 加载中..."
                               FontSize="13" Foreground="#88AABB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Tab: 密码（2列卡片网格） -->
                <ScrollViewer x:Name="PanelPassword" Margin="8,8,8,4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Visible">
                    <UniformGrid x:Name="GridPassword" Columns="3" VerticalAlignment="Top"/>
                </ScrollViewer>

                <!-- Tab: 制作 -->
                <ScrollViewer x:Name="PanelCraft" Margin="10,6,10,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="StackCraft"/>
                </ScrollViewer>

                <!-- Tab: 活动&材料 -->
                <ScrollViewer x:Name="PanelItems" Margin="10,6,10,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="StackItems"/>
                </ScrollViewer>

                <!-- Tab: 子弹 -->
                <ScrollViewer x:Name="PanelAmmo" Margin="10,6,10,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="StackAmmo"/>
                </ScrollViewer>

                <!-- Tab: 装备计算 -->
                <ScrollViewer x:Name="PanelArmor" Margin="10,8,10,6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel x:Name="StackArmor"/>
                </ScrollViewer>

                <!-- Tab: 改枪 -->
                <Grid x:Name="PanelGun" Margin="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" Margin="8,6,8,4"
                            Background="#1E2D3D" BorderBrush="#446688"
                            BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="7,0,4,0" Foreground="#7EC8E3"/>
                            <TextBox x:Name="TxtGunSearch" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#E0E8F0" CaretBrush="#7EC8E3"
                                     FontSize="12" VerticalAlignment="Center"
                                     Padding="0,5,6,5"
                                     TextChanged="OnGunSearchChanged">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="Hint" TileMode="None"
                                                         Opacity="0.4" Stretch="None"
                                                         AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="搜索武器名称..."
                                                               Foreground="#7EC8E3"
                                                               FontSize="12"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <Border x:Name="hint"
                                                                Background="{StaticResource Hint}"
                                                                Visibility="Collapsed"/>
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="Text" Value=""/>
                                                                <Condition Property="IsKeyboardFocused" Value="False"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <!-- 武器列表 -->
                    <ScrollViewer Grid.Row="1" Margin="8,0,8,4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="StackGunList"/>
                    </ScrollViewer>
                </Grid>

            </Grid>

            <!-- ── 底部（热键提示 + Resize Grip） ── -->
            <Border Grid.Row="3" Background="#0AFFFFFF" CornerRadius="0,0,10,10">
                <Grid>
                    <TextBlock x:Name="TxtHint"
                               Text="拖动移动  |  F10 显示/隐藏"
                               FontSize="10" Foreground="#33AABB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <!-- 右下角拖拽调整大小 -->
                    <p:ResizeGrip x:Name="SizeGrip"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Width="16" Height="16"
                                  Cursor="SizeNWSE"
                                  MouseLeftButtonDown="OnResizeGripMouseDown"
                                  MouseMove="OnResizeGripMouseMove"
                                  MouseLeftButtonUp="OnResizeGripMouseUp"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
