<Window x:Class="MouseTool.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鼠鼠工具 · 设置"
        Width="380" Height="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        Foreground="White"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Label 样式 -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AABBCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 数值标签 -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7EC8E3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- 滑块样式 -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#7EC8E3"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <!-- 分组标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7EC8E3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>

        <!-- 普通按钮 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D3748"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#FF4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D4F6A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF7F1D1D"/>
            <Setter Property="BorderBrush" Value="#FFEF4444"/>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#AABBCC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D3748"/>
            <Setter Property="Foreground" Value="#E8EAF0"/>
            <Setter Property="BorderBrush" Value="#FF4A5568"/>
            <Setter Property="CaretBrush" Value="#7EC8E3"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Margin="0" Background="#FF1E1E2E">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">

                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="🐭" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="鼠鼠工具 · 设置" FontSize="16"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#FF2D3748" Margin="0,0,0,12"/>

                <!-- ── 显示设置 ── -->
                <TextBlock Text="显示" Style="{StaticResource GroupTitle}"/>

                <!-- 透明度 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="透明度" Style="{StaticResource Label}"/>
                        <Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnOpacityChanged"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtOpacity"
                               Style="{StaticResource ValueLabel}"
                               VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                </Grid>

                <!-- 字体大小 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="字体大小" Style="{StaticResource Label}"/>
                        <Slider x:Name="SliderFont" Minimum="10" Maximum="22"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnFontSizeChanged"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtFont"
                               Style="{StaticResource ValueLabel}"
                               VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                </Grid>

                <!-- 背景色预设 -->
                <TextBlock Text="背景色预设" Style="{StaticResource Label}" Margin="0,4,0,6"/>
                <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="BtnBgDark"   Content="深夜蓝"  Width="72" Margin="0,0,6,6"
                            Tag="#FF101827" Click="OnBgPresetClicked"/>
                    <Button x:Name="BtnBgBlack"  Content="纯黑"    Width="72" Margin="0,0,6,6"
                            Tag="#FF000000" Click="OnBgPresetClicked"/>
                    <Button x:Name="BtnBgGreen"  Content="暗绿"    Width="72" Margin="0,0,6,6"
                            Tag="#FF0A1F0F" Click="OnBgPresetClicked"/>
                    <Button x:Name="BtnBgWarm"   Content="暗红"    Width="72" Margin="0,0,6,6"
                            Tag="#FF1F0A0A" Click="OnBgPresetClicked"/>
                </WrapPanel>

                <!-- 描边 / 置顶 -->
                <CheckBox x:Name="ChkBorder"  Content="显示描边" Margin="0,0,0,6"
                          Click="OnBorderToggled"/>
                <CheckBox x:Name="ChkTopmost" Content="总是置顶" Margin="0,0,0,10"
                          Click="OnTopmostToggled"/>

                <Separator Background="#FF2D3748" Margin="0,2,0,12"/>

                <!-- ── 热键 ── -->
                <TextBlock Text="热键" Style="{StaticResource GroupTitle}"/>
                <TextBlock Style="{StaticResource Label}"
                           Text="显示 / 隐藏悬浮窗的全局热键（单键，如 F10）："/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtHotkey" Margin="0,0,8,0"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown"
                             IsReadOnly="True" Cursor="Arrow"/>
                    <Button Grid.Column="1" Content="应用" Click="OnApplyHotkey"/>
                </Grid>

                <Separator Background="#FF2D3748" Margin="0,2,0,12"/>

                <!-- ── 位置 ── -->
                <TextBlock Text="位置" Style="{StaticResource GroupTitle}"/>
                <Button Content="重置到屏幕左上角" HorizontalAlignment="Left"
                        Margin="0,0,0,12" Click="OnResetPosition"/>

                <Separator Background="#FF2D3748" Margin="0,2,0,12"/>

                <!-- ── 操作 ── -->
                <TextBlock Text="操作" Style="{StaticResource GroupTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="关闭程序" Width="100" Margin="0,0,10,0"
                            Style="{StaticResource DangerButton}"
                            Click="OnCloseApp"/>
                    <Button Content="关闭设置" Width="100"
                            Click="OnCloseSettings"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>

</Window>
